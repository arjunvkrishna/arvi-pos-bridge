# Bridge Configuration Example
BACKEND_BASE_URL=http://localhost:8080
# Cafe code and bridge token for THIS cafe, both shown in the SaaS console (GET /api/super-admin/cafes/{id}/bridge-token)
TENANT_CODE=your_cafe_code
PRINTER_BRIDGE_TOKEN=your_bridge_token_here
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password
BRIDGE_ID=bridge-counter-01

# Optional printer hardware fallbacks (can also be configured via POS Settings UI)
BILL_PRINTER_HOST=192.168.1.200
BILL_PRINTER_PORT=9100
KITCHEN_PRINTER_HOST=192.168.1.201
KITCHEN_PRINTER_PORT=9100
JUICE_PRINTER_HOST=192.168.1.202
JUICE_PRINTER_PORT=9100
